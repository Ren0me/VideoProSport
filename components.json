{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/_app/styles/globals.scss",
    "baseColor": "neutral",
    "cssVariables": false
  },
  "aliases": {
    "components": "@shared/ui/organisms",
    "ui": "@shared/ui/atoms",
    "lib": "@shared/lib",
    "hooks": "@shared/lib/hooks",
    "utils": "@shared/lib/utils"
  },
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@reactbits-starter": {
      "url": "https://pro.reactbits.dev/api/r/starter/{name}.json",
      "headers": {
        "Authorization": "${REACTBITS_LICENSE_KEY}"
      }
    },
    "@reactbits-pro": {
      "url": "https://pro.reactbits.dev/api/r/pro/{name}.json",
      "headers": {
        "Authorization": "${REACTBITS_LICENSE_KEY}"
      }
    }
  }
}
